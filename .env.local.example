# Copy to .env.local and fill in. NEVER commit .env.local.

# Postgres connection used by the `pg` driver for ALL SQL (API routes + seed scripts).
# Supabase: Project Settings -> Database -> Connection string.
# Use the DIRECT connection (port 5432) or the SESSION-mode pooler (port 5432),
# NOT transaction-mode pooling (port 6543): the watchlist transaction needs
# BEGIN/COMMIT on a single session.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# true for Supabase (it requires TLS), false for a local Postgres.
DATABASE_SSL=true

# Supabase Auth. Project Settings -> API Keys -> "Publishable key" (sb_publishable_...).
# It is public by design (it ships to the browser). NEVER put the secret key
# (sb_secret_...) or DATABASE_URL in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# SEC EDGAR fair-access policy: identify yourself as "Name email" or SEC returns 403.
# Used only by seed/fetch_data.py.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: test logins used ONLY by scripts/test-roles.ts (real Supabase Auth
# users; set their roles with db/admin/set_role.sql). Never commit real values.
TEST_ANALYST_EMAIL=
TEST_ANALYST_PASSWORD=
TEST_VIEWER_EMAIL=
TEST_VIEWER_PASSWORD=
