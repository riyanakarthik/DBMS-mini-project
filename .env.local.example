# Copy to .env.local and fill in. NEVER commit .env.local.

# Postgres connection used by the `pg` driver for ALL SQL (API routes + seed scripts).
# Supabase: Project Settings -> Database -> Connection string.
# Use the DIRECT connection (port 5432) or the SESSION-mode pooler (port 5432),
# NOT transaction-mode pooling (port 6543): the watchlist transaction needs
# BEGIN/COMMIT on a single session.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# true for Supabase (it requires TLS), false for a local Postgres.
DATABASE_SSL=true

# Supabase Auth (Phase 4). The anon key is public by design; never put the
# service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# SEC EDGAR fair-access policy: identify yourself as "Name email" or SEC returns 403.
# Used only by seed/fetch_data.py.
SEC_USER_AGENT="Your Name your.email@example.com"

# TODO(Phase 4): remove. Temporary watchlist user until Supabase Auth exists.
# Create it with: psql "$DATABASE_URL" -f db/demo/create_demo_user.sql (prints the UUID)
DEMO_USER_ID=
